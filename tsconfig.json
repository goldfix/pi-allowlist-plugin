{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    // Relative imports use explicit `.ts` extensions so the same source runs
    // under plain Node type-stripping (`node --test`) and under Pi's jiti loader.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["extensions", "test"]
}
